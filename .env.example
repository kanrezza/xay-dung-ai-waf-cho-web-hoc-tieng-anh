PORT=8080

# Khóa ký cookie phiên đăng nhập, bắt buộc khi chạy thật (ít nhất 32 ký tự ngẫu nhiên).
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# SESSION_SECRET=

# PostgreSQL: trên Railway chỉ cần DATABASE_URL (lấy từ dịch vụ Postgres).
# Chạy local thì bỏ DATABASE_URL và dùng các biến PG* bên dưới.
# DATABASE_URL=postgresql://postgres:matkhau@host:5432/railway
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=engpro

# Dung lượng video bài giảng tối đa (MB), mặc định 500
# VIDEO_MAX_MB=500

# Gửi email (mã đặt lại mật khẩu, mã xác nhận email, tin nhắn liên hệ).
# Gmail: bật Xác minh 2 bước rồi tạo "Mật khẩu ứng dụng" tại https://myaccount.google.com/apppasswords
# Bỏ trống thì email được in ra cửa sổ chạy server thay vì gửi thật.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tencuaban@gmail.com
# SMTP_PASS=matkhauungdung16kytu
# MAIL_FROM="EngPro <tencuaban@gmail.com>"
# CONTACT_EMAIL=hopthunhanlienhe@gmail.com
# Khi đang phát triển: chuyển email về một hộp thư thử, tiêu đề ghi rõ người nhận gốc. Xóa khi chạy thật.
# MAIL_REDIRECT_TO=hopthucuaban@gmail.com
# Chỉ chuyển hướng thư tới các địa chỉ này (ví dụ tài khoản mẫu là hộp thư của người khác), thư khác gửi thẳng.
# Bỏ trống thì mọi thư đều chuyển về MAIL_REDIRECT_TO.
# MAIL_REDIRECT_ONLY=admin@gmail.com,hoang@gmail.com,danh@gmail.com

# Địa chỉ web khi đã đưa lên mạng, dùng cho nút "Làm bài ngay" trong email nhắc hạn nộp
# APP_URL=https://engpro.up.railway.app

# Thanh toán học phí qua VNPay. Đăng ký tài khoản thử nghiệm miễn phí tại https://sandbox.vnpayment.vn/devreg/
# rồi điền mã website và chuỗi bí mật VNPay gửi qua email. Bỏ trống thì chỉ có chuyển khoản thủ công.
# VNP_TMN_CODE=
# VNP_HASH_SECRET=
# VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Trợ lý AI (Google Gemini): giải thích câu làm sai, nhận xét quá trình học, chấm Writing, tạo câu hỏi cho giảng viên.
# Tạo khóa miễn phí tại https://aistudio.google.com/apikey. Bỏ trống thì các nút AI tự ẩn hoặc báo chưa bật.
# Lưu ý: gói miễn phí của Google có thể dùng nội dung gửi lên để cải thiện sản phẩm, hệ thống không gửi họ tên hay email.
# GEMINI_API_KEY=
# Model mới nhất gần như không có hạn mức miễn phí; bản dưới đây dùng được với gói miễn phí
# GEMINI_MODEL=gemini-3.6-flash
# Gói miễn phí giới hạn số lượt mỗi phút cho từng model. Model chính bận thì hệ thống tự gọi model dự phòng.
# GEMINI_MODEL_FALLBACKS=gemini-3.1-flash-lite,gemini-3.5-flash
# Nhiều key của các project khác nhau, cách nhau bằng dấu phẩy, dùng để chia đều lượt gọi
# GEMINI_API_KEYS=key_project_1,key_project_2
# Số lượt mỗi người được dùng mỗi ngày (quản trị viên không giới hạn)
# AI_LIMIT_EXPLAIN=40
# AI_LIMIT_INSIGHTS=5
# AI_LIMIT_WRITING=5
# AI_LIMIT_GENERATE=20
# Trần tổng cho cả website mỗi ngày, bảo vệ hạn mức của project Google. Bỏ trống là không giới hạn.
# Giảng viên và quản trị viên không bị tính vào trần này.
# AI_DAILY_TOTAL=500
# Chạy thử giao diện không cần khóa, AI trả dữ liệu mẫu (chỉ dùng khi phát triển)
# AI_PROVIDER=mock
