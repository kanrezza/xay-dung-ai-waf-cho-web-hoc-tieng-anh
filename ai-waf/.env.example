# ── Cấu hình AI WAF cho EngPro ──
# Chép file này thành .env (cùng thư mục) rồi sửa. File .env không lên GitHub.
# Biến đặt trên dòng lệnh được ưu tiên hơn biến trong .env.

# Tài khoản vào dashboard và API /waf/api/*. Bỏ trống mật khẩu thì mỗi lần chạy
# WAF tự sinh một mật khẩu tạm và in ra cửa sổ dòng lệnh.
WAF_ADMIN_USER=admin
WAF_ADMIN_PASSWORD=
# WAF_ADMIN_MAX_FAIL=5

# IP của proxy / cân bằng tải đứng TRƯỚC WAF, cách nhau bằng dấu phẩy. Chỉ
# request từ các IP này mới được tin header X-Forwarded-For. Chạy WAF trực
# tiếp trên máy thì để trống, nếu không kẻ tấn công giả được IP.
# WAF_TRUSTED_PROXIES=

# WAF nghe ở cổng này (người dùng truy cập http://localhost:8000 thay vì 8080)
WAF_PORT=8000
# EngPro thật (backend được bảo vệ)
BACKEND_URL=http://127.0.0.1:8080

# Ngưỡng điểm mô hình ML để chặn (0..1). Cao hơn -> ít chặn nhầm nhưng dễ bỏ sót
ML_THRESHOLD=0.80

# Chỉ ghi log, KHÔNG chặn (để đo tỉ lệ báo nhầm trước khi bật chặn thật)
# WAF_DETECTION_ONLY=1

# Bật/tắt từng lớp để demo "trước và sau" (mặc định bật cả 3)
# WAF_ENABLE_RULES=1
# WAF_ENABLE_ML=1
# WAF_ENABLE_ANOMALY=1

# Giới hạn tần suất (lớp hành vi)
# WAF_RATE_WINDOW_SEC=10
# WAF_RATE_MAX_REQ=80
# WAF_LOGIN_MAX_FAIL=8
