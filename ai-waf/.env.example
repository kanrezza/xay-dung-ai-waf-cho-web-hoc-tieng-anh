# ── Cấu hình AI WAF cho EngPro ──
# WAF nghe ở cổng này (người dùng truy cập http://localhost:8000 thay vì 8080)
WAF_PORT=8000
# EngPro thật (backend được bảo vệ)
BACKEND_URL=http://127.0.0.1:8080

# Ngưỡng điểm mô hình ML để chặn (0..1). Cao hơn -> ít chặn nhầm nhưng dễ bỏ sót
ML_THRESHOLD=0.80

# Chỉ ghi log, KHÔNG chặn (để đo tỉ lệ báo nhầm trước khi bật chặn thật)
# WAF_DETECTION_ONLY=1

# Bật/tắt từng lớp để demo "trước và sau" (mặc định bật cả 3)
# WAF_ENABLE_RULES=1
# WAF_ENABLE_ML=1
# WAF_ENABLE_ANOMALY=1

# Giới hạn tần suất (lớp hành vi)
# WAF_RATE_WINDOW_SEC=10
# WAF_RATE_MAX_REQ=80
# WAF_LOGIN_MAX_FAIL=8
